# ==============================================================================
# KOVA POS — Environment Configuration Template
# Copy to .env (`cp .env.example .env`) before running locally or via Docker.
# ==============================================================================

# --- Backend HTTP & Security ---
PORT=8080
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# IMPORTANT: Replace these secrets in any staging or production deployment!
JWT_SECRET=kova-pos-dev-jwt-secret-change-in-production
PIN_TOKEN_SECRET=kova-pos-dev-pin-secret-change-in-production

# --- PostgreSQL 16 (Master Control Plane + Dynamic pos_tenant_<slug> DBs) ---
POSTGRES_USER=pos_admin
POSTGRES_PASSWORD=pos_secret
POSTGRES_DB=enterprise_pos

# Used when running the Go backend natively on the host (`cd backend && go run ./cmd/api`):
DATABASE_URL=postgres://pos_admin:pos_secret@localhost:5432/enterprise_pos?sslmode=disable

# Used inside Docker Compose network (`docker compose up`):
DOCKER_DATABASE_URL=postgres://pos_admin:pos_secret@postgres:5432/enterprise_pos?sslmode=disable

# --- Redis 7.2 (Settings Cache, Lua Rate Limiter & Asynq Queue) ---
# Native host development:
REDIS_ADDR=localhost:6379
# Docker Compose network:
DOCKER_REDIS_ADDR=redis:6379

# --- Frontend Vite Dev Proxy (`frontend/vite.config.ts`) ---
VITE_API_TARGET=http://localhost:8080

